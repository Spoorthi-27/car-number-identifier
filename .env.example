# Optional settings. None of these are secrets.
# Copy to .env only if you load it yourself; the app reads the process environment.

# Webcam index used when the UI does not pass one. 0 is the default camera.
CAMERA_INDEX=0

# SQLite file. A relative path is stored inside the project directory.
DB_PATH=database/plates.db

# Cropped plate images saved next to each log row. Set to 0 to disable.
SAVE_SNAPSHOTS=1
SNAPSHOT_DIR=output/snapshots

# Full path to the tesseract binary, if it is not on PATH.
TESSERACT_CMD=

# YOLO detection confidence, from 0 to 1.
CONF_THRESHOLD=0.55

# How long to wait before logging the same plate again from a live camera.
DEDUPE_SECONDS=5

# Hugging Face model id, or a local best.pt path.
MODEL_NAME=keremberke/yolov5s-license-plate
